<section class="favorites-page">

    <h1>Your Favorites</h1>

    <%- messages() %>

        <% if (favorites.length> 0) { %>
            <ul class="favorites-grid">
                <% favorites.forEach(vehicle=> { %>
                    <li class="favorite-card">

                        <img src="<%= vehicle.inv_thumbnail %>" alt="<%= vehicle.inv_make %>">

                        <h3>
                            <%= vehicle.inv_make %>
                                <%= vehicle.inv_model %>
                        </h3>

                        <p>$<%= vehicle.inv_price.toLocaleString() %>
                        </p>

                        <form method="post" action="/favorites/remove">
                            <input type="hidden" name="inv_id" value="<%= vehicle.inv_id %>">
                            <button class="favorite-remove-btn">Remove</button>
                        </form>

                    </li>
                    <% }) %>
            </ul>
            <% } else { %>
                <p>You have no favorites yet.</p>
                <% } %>

</section>