<h1>
    <%= title %>
</h1>
<p>Confirm Deletion!!! This action cannot be undone.</p>

<%- messages() %>

    <form id="deleteForm" action="/inv/delete" method="post">

        <!-- MAKE -->
        <label for="inv_make">Make</label>
        <input type="text" name="inv_make" id="inv_make" required pattern="^[A-Za-z0-9 ]+$"
            value="<%= locals.inv_make || '' %>">

        <!-- MODEL -->
        <label for="inv_model">Model</label>
        <input type="text" name="inv_model" id="inv_model" required pattern="^[A-Za-z0-9 ]+$"
            value="<%= locals.inv_model || '' %>">

        <!-- YEAR -->
        <label for="inv_year">Year</label>
        <input type="number" name="inv_year" id="inv_year" required min="1900" max="2099"
            value="<%= locals.inv_year || '' %>">

        <!-- PRICE -->
        <label for="inv_price">Price</label>
        <input type="number" name="inv_price" id="inv_price" required min="0" step="0.01"
            value="<%= locals.inv_price || '' %>">

        
        <button type="submit">Delete Inventory</button>
        <input type="hidden" name="inv_id" 
        <% if(locals.inv_id) { %> value="<%= locals.inv_id %>"
            <% } %>>
    </form>


    <% if (errors) { %>
        <ul class="errors">
            <% errors.forEach(error=> { %>
                <li>
                    <%= error.msg %>
                </li>
                <% }) %>
        </ul>
        <% } %>