
<h1>
    <%= title %>
</h1>

<!-- Flash message -->
<%- messages() %>

<div class = "message">You're logged in</div>


<% if (errors) { %>
    <ul class="errors">
        <% errors.array().forEach(error=> { %>
            <li>
                <%= error.msg %>
            </li>
            <% }) %>
    </ul>
<% } %>